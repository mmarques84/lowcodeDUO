# Copie para .env e preencha com valores reais antes de rodar `docker compose up`.
# .env nunca é commitado (ver .gitignore).

MYSQL_ROOT_PASSWORD=troque-esta-senha
MYSQL_DATABASE=lowcodeduo
MYSQL_USER=app_user
MYSQL_PASSWORD=troque-esta-senha

N8N_POSTGRES_PASSWORD=troque-esta-senha
N8N_ENCRYPTION_KEY=gere-uma-chave-aleatoria-forte

JWT_SECRET=gere-um-segredo-aleatorio-forte

# Credenciais do front pra conectar no MySQL acima (mesmos valores de cima)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=troque-esta-senha
DB_NAME=lowcodeduo
